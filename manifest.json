{
  "manifest_version": 3,
  "name": "Text/Image Sender",
  "version": "1.0",
  "description": "Send text or images to local FastAPI server",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://localhost:8000/*"
  ]
} 